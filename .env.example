# GROQ_API_KEY: Required for Groq AI investigation intelligence.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL: Configurable Groq model (e.g. llama-3.3-70b-versatile or llama-3.1-8b-instant).
GROQ_MODEL="llama-3.3-70b-versatile"

# GEMINI_API_KEY: Optional Gemini AI fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, API endpoints, and WhatsApp deep links.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# WhatsApp investigator alerting (BACKEND ONLY — never expose these to React).
# ---------------------------------------------------------------------------

# WHATSAPP_MODE: "mock" (default, no real messages — for demo) or "live".
WHATSAPP_MODE="mock"

# WHATSAPP_ENABLED: master switch for the alerting pipeline.
WHATSAPP_ENABLED="true"

# WHATSAPP_PROVIDER: currently supports "meta" (WhatsApp Business / Cloud API).
WHATSAPP_PROVIDER="meta"

# Meta WhatsApp Cloud API credentials (required only when WHATSAPP_MODE=live).
WHATSAPP_ACCESS_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="MY_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_API_VERSION="v21.0"

# Verification token for the inbound delivery-status webhook (POST /api/webhooks/whatsapp).
WHATSAPP_WEBHOOK_VERIFY_TOKEN="MY_WHATSAPP_WEBHOOK_VERIFY_TOKEN"

# Approved message template used for proactive investigator notifications.
WHATSAPP_ALERT_TEMPLATE="claimshield_anomaly_alert"

# Optional demo recipients (phone numbers) for the seeded investigators.
WHATSAPP_DEMO_RECIPIENT="+10000000001"
WHATSAPP_DUTY_OFFICER="+10000000009"
